<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/mp_color_primary"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Internal System Diagnostics"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_diagnostic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Diagnostic Profiling: ON / OFF"
        android:textColor="@android:color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Queue Hardware Event (5s Buffer)"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:alpha="0.7" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="2">

        <Button
            android:id="@+id/action_param_0"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Param 0"
            android:textColor="@android:color/white"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/action_param_1"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Param 1"
            android:textColor="@android:color/white"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/action_param_2"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Param 2"
            android:textColor="@android:color/white"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/action_param_3"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Param 3"
            android:textColor="@android:color/white"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/action_param_4"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Param 4"
            android:textColor="@android:color/white"
            android:textAlignment="viewStart" />

        <Button
            android:id="@+id/action_param_5"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:text="Param 5"
            android:textColor="@android:color/white"
            android:textAlignment="viewStart" />

    </GridLayout>

</LinearLayout>